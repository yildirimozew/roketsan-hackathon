# Copy to .env (gitignored). All backend settings use the SENTINEL_ prefix (backend/app/core/config.py).
# Relative paths are resolved from the repo root.

# Data: the organizer's files (committed in data/), or data/stage2_mock from `make mock-data`.
SENTINEL_DATA_DIR=data
# PrecomputedDetector boxes, also the fallback when the live model fails. Default:
# backend/.cache/detections.json, written by `make detections`.
# SENTINEL_DETECTIONS_FILE=data/stage2_mock/detections.json

# LLM: organizer's OpenAI-compatible GLM gateway (empty base URL = the gateway).
# Leave the key empty to run with the deterministic fallbacks.
SENTINEL_LLM_BASE_URL=
SENTINEL_LLM_MODEL=glm-5.3-flash
GLM_API_KEY=

# Watch mode: watchers share the 8 sectors and take turns (1-8); trackers are backlog.
SENTINEL_WATCHER_COUNT=4
SENTINEL_TRACKERS_ENABLED=false
SENTINEL_WATCHER_REASONING_EFFORT=low
SENTINEL_SUPERVISOR_REASONING_EFFORT=high
SENTINEL_BRIEF_LANGUAGE=tr

# Detector: "precomputed" (JSON above) or "ultralytics" (needs `make install-detector` + weights).
SENTINEL_DETECTOR_KIND=ultralytics
SENTINEL_DETECTOR_WEIGHTS=
SENTINEL_DETECTOR_DEVICE=auto
SENTINEL_DETECTOR_IMGSZ=960
SENTINEL_DETECT_CONF_MIN=0.35

# Agent tunables (AGENT_DESIGN §3)
SENTINEL_MATCH_MAX_M=25
SENTINEL_REPORT_RADIUS_M=300
SENTINEL_STOP_SPEED_MS=1.0
SENTINEL_ZONE_RADIUS_M=2000
